/**
 * おのみち部活さがし — 引き継ぎ資料をスプレッドシートの中に作る
 *
 * 【使い方】Apps Script エディタで setupHandoverSheet() を実行してください。
 *          「引き継ぎ」シートができます。内容を直したいときは、シートを直接編集して構いません。
 *          もう一度この関数を実行すると、今のシートは「引き継ぎ（旧 日付）」に名前を変えて残し、
 *          新しいシートを作り直します（書き込んだメモが消えないように）。
 */

const HANDOVER_SHEET_NAME = '引き継ぎ';

function setupHandoverSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const existing = ss.getSheetByName(HANDOVER_SHEET_NAME);
  if (existing) {
    const stamp = Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
    existing.setName(HANDOVER_SHEET_NAME + '（旧 ' + stamp + '）');
  }

  const sheet = ss.insertSheet(HANDOVER_SHEET_NAME, 0);
  const doc = handoverContent_();

  // --- 値をまとめて書く ---
  const values = doc.map(r => [r[1] || '', r[2] || '', r[3] || '']);
  sheet.getRange(1, 1, values.length, 3).setValues(values);

  // --- 体裁 ---
  sheet.setColumnWidth(1, 330);
  sheet.setColumnWidth(2, 430);
  sheet.setColumnWidth(3, 260);
  sheet.getRange(1, 1, values.length, 3)
    .setVerticalAlignment('top').setWrap(true).setFontFamily('Arial').setFontSize(10);

  doc.forEach((r, i) => {
    const row = i + 1;
    const line = sheet.getRange(row, 1, 1, 3);
    switch (r[0]) {
      case 'h1':
        line.merge().setFontSize(16).setFontWeight('bold').setBackground('#1E6E8C').setFontColor('#FFFFFF');
        sheet.setRowHeight(row, 34);
        break;
      case 'h2':
        line.merge().setFontSize(13).setFontWeight('bold').setBackground('#DFECF2');
        sheet.setRowHeight(row, 28);
        break;
      case 'h3':
        line.merge().setFontWeight('bold').setFontColor('#1E6E8C');
        break;
      case 'p':
        line.merge();
        break;
      case 'warn':
        line.merge().setBackground('#F8E7DA').setFontWeight('bold');
        break;
      case 'th':
        line.setFontWeight('bold').setBackground('#F2F5F4');
        break;
      case 'tr':
        // 1列しか使っていない行は横につなげて、文章として読めるようにする
        if (!r[2] && !r[3]) line.merge();
        break;
      case 'blank':
        sheet.setRowHeight(row, 10);
        break;
    }
  });

  sheet.setFrozenRows(1);
  sheet.getRange(1, 1).activate();
  return sheet;
}

